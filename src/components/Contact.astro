---
import { DEFAULT_LANG, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang).contact;
---
<section id="contact">
    <div class="section-header reveal">
        <h2>{dict.title}</h2>
        <div class="section-line"></div>
    </div>
    <div class="contact-grid reveal">
        <a href="https://www.linkedin.com/in/tom2824/" class="contact-card" target="_blank" rel="noopener">
            <img src="/images/linkedin.png" alt="LinkedIn">
            <span>LinkedIn</span>
        </a>
        <a href="https://github.com/tom2824" class="contact-card" target="_blank" rel="noopener">
            <img src="/images/github.svg" alt="GitHub">
            <span>GitHub</span>
        </a>
        <a href="mailto:nguyen.tom.2824@gmail.com" class="contact-card">
            <img src="/images/email.png" alt="Email">
            <span>nguyen.tom.2824@gmail.com</span>
        </a>
    </div>
</section>
