---
import { DEFAULT_LANG, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang).about;
---
<section id="about">
    <div class="section-header reveal">
        <h2>{dict.title}</h2>
        <div class="section-line"></div>
    </div>
    <div class="about-grid">
        <div class="about-content reveal">
            <p class="about-text">{dict.text1}</p>
            <div class="about-seeking">
                <h3>{dict.seekingTitle}</h3>
                <ul>
                    {dict.seeking.map((item) => <li><strong>{item.label}</strong>{item.value}</li>)}
                </ul>
            </div>
            <p class="about-text">{dict.text2}</p>
            <h3 class="about-interests-title">{dict.interestsTitle}</h3>
            <div class="interest-tags">
                {dict.interests.map((interest) => <span class="tag">{interest}</span>)}
            </div>
        </div>
        <div class="about-image-wrapper reveal">
            <img src="/images/pc_build.jpg" alt={dict.imageAlt}>
        </div>
    </div>
</section>
