---
import type { Project } from '../data/projects';
import { DEFAULT_LANG, localized, t, type Lang } from '../i18n';

interface Props {
  project: Project;
  lang?: Lang;
}
const { project, lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang).projects;

// Badge "Projet récent" si date < 12 mois
const [year, month] = project.date.split('-').map(Number);
const projectDate = new Date(year, (month || 1) - 1, 1);
const oneYearAgo = new Date();
oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
const isRecent = projectDate >= oneYearAgo;

let displayDate: string;
if (project.ongoing) {
  displayDate = `${year} — ${dict.present}`;
} else if (month) {
  displayDate = `${dict.months[month - 1]} ${year}`;
} else {
  displayDate = String(year);
}
const description = project.description[lang];
---

<div class="project-card reveal" data-date={project.date} data-title={project.title}>
  {isRecent && <div class="featured-badge">{dict.recent}</div>}
  <div class="card-header">
    <h3>{project.title}</h3>
    <span class="card-date">{displayDate}</span>
  </div>
  <div class="card-tags">
    {project.tags.map(tag => (
      <span>
        {tag.icon && <img src={`/${tag.icon}`} alt="" loading="lazy" />}
        {tag.label}
      </span>
    ))}
  </div>
  <p>{description}</p>
  {project.collaborators && (
    <div class="card-collaborators">
      {dict.with}{' '}
      {project.collaborators.map((c, i) => (
        <>
          {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}</a> : c.name}
          {i < project.collaborators!.length - 2 ? ', ' : i === project.collaborators!.length - 2 ? dict.and : ''}
        </>
      ))}
    </div>
  )}
  {project.demo ? (
    <div class="card-actions">
      <a href={localized(project.demo, lang)} class="card-action">
        {dict.demo} <span class="card-action-arrow">&#8594;</span>
      </a>
      {project.link && (
        <a href={project.link} class="card-action secondary" target="_blank" rel="noopener">
          {dict.code}
        </a>
      )}
    </div>
  ) : project.link && (
    <a href={project.link} class="card-action" target="_blank" rel="noopener">
      {dict.view} <span class="card-action-arrow">&#8594;</span>
    </a>
  )}
</div>
