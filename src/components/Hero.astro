---
import cv from '../data/cv.json';
import { DEFAULT_LANG, localized, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang).hero;
---
<section id="hero">
    <div class="hero-content">
        <div class="hero-image-wrapper reveal">
            <img src="/images/pp_pro_2026.jpg" alt="Tom NGUYEN" class="hero-image">
        </div>
        <h1 class="hero-title reveal">
            <span class="hero-greeting">{dict.greeting}</span>
            <span class="hero-name">Tom NGUYEN</span>
        </h1>
        <p class="hero-subtitle reveal"><span id="age"></span> {dict.subtitle}</p>
        <p class="hero-status reveal">{dict.status}</p>
        <p class="hero-description reveal">{dict.description}</p>
        <div class="hero-cta reveal">
            <a href="#projects" class="btn btn-primary">{dict.projects}</a>
            <a href="#contact" class="btn btn-outline">{dict.contact}</a>
            <a href={localized('/cv', lang)} class="btn btn-outline" title={dict.cvTitle(cv.version, cv.date)}>{dict.cv}</a>
        </div>
    </div>
    <div class="scroll-indicator">
        <div class="scroll-line"></div>
    </div>
</section>
