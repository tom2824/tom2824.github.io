---
import { DEFAULT_LANG, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang).reflexive;
---
<section id="reflexive">
    <div class="section-header reveal">
        <h2>{dict.title}</h2>
        <div class="section-line"></div>
    </div>

    <div class="reflexive-intro reveal">
        <p>{dict.intro}</p>
    </div>

    <div class="reflexive-grid">

        <div class="reflexive-card reveal">
            <div class="reflexive-icon">&#9889;</div>
            <h3>{dict.discovered.title}</h3>
            <p>{dict.discovered.text}</p>
        </div>

        <div class="reflexive-card reveal">
            <div class="reflexive-icon">&#9899;</div>
            <h3>{dict.strengths.title}</h3>
            <ul>
                {dict.strengths.items.map((item) => <li><strong>{item.label}</strong> {item.text}</li>)}
            </ul>
        </div>

        <div class="reflexive-card reveal">
            <div class="reflexive-icon">&#9898;</div>
            <h3>{dict.growth.title}</h3>
            <p>{dict.growth.text1a}<strong>{dict.growth.text1b}</strong>{dict.growth.text1c}</p>
            <p>{dict.growth.text2}</p>
        </div>

        <div class="reflexive-card reveal">
            <div class="reflexive-icon">&#9203;</div>
            <h3>{dict.needs.title}</h3>
            <ul>
                {dict.needs.items.map((item) => <li>{item}</li>)}
            </ul>
        </div>

    </div>
</section>
