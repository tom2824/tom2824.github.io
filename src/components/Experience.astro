---
import { DEFAULT_LANG, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang).experience;

const ICONS: Record<string, string> = {
  'C#': '/images/csharp.svg',
  MSSQL: '/images/SSMS.png',
  JavaScript: '/images/js.png',
  XML: '/images/xml.svg',
  Bash: '/images/bash.png',
  Snowflake: '/images/snowflake.svg',
};
---
<section id="experience">
    <div class="section-header reveal">
        <h2>{dict.title}</h2>
        <div class="section-line"></div>
    </div>
    <div class="timeline">
        {dict.entries.map((entry, index) => (
            <div class:list={['timeline-item', 'reveal', { featured: index === 0 }]}>
                <div class="timeline-marker"></div>
                <div class="timeline-content">
                    <span class="timeline-badge work">{entry.badge}</span>
                    <h3>{entry.title}</h3>
                    <span class="timeline-date">{entry.date}</span>
                    {'tags' in entry && entry.tags && (
                        <div class="card-tags">
                            {entry.tags.map((tag) => (
                                <span>{ICONS[tag] && <img src={ICONS[tag]} alt="" loading="lazy" />}{tag}</span>
                            ))}
                        </div>
                    )}
                    {'context' in entry && entry.context && <p class="experience-context">{entry.context}</p>}
                    {'missions' in entry && entry.missions && (
                        <ul class="experience-missions">
                            {entry.missions.map((mission) => <li>{mission}</li>)}
                        </ul>
                    )}
                    {'autonomy' in entry && entry.autonomy && (
                        <p class="experience-autonomy"><strong>{dict.autonomyLabel}</strong> {entry.autonomy}</p>
                    )}
                    {'text' in entry && entry.text && <p>{entry.text}</p>}
                </div>
            </div>
        ))}
    </div>
</section>
