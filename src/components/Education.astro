---
import { DEFAULT_LANG, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const dict = t(lang).education;
---
<section id="education">
    <div class="section-header reveal">
        <h2>{dict.title}</h2>
        <div class="section-line"></div>
    </div>
    <div class="timeline">
        {dict.entries.map((entry, index) => (
            <div class:list={['timeline-item', 'reveal', { featured: index === 0 }]}>
                <div class="timeline-marker edu"></div>
                <div class="timeline-content">
                    <span class="timeline-badge edu">{entry.badge}</span>
                    <h3>{entry.title}</h3>
                    <span class="timeline-date">{entry.date}</span>
                    <p>{entry.text}</p>
                </div>
            </div>
        ))}
    </div>
</section>
